# AgriChain backend configuration — TEMPLATE.
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. This file is committed, so it
# must only ever contain placeholders — no real credentials.

# --- Database -----------------------------------------------------------------
# Async driver is required (asyncpg), not plain postgresql://
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/agrichain_db

# Same database, sync driver. Used by the standalone maintenance scripts
# (seed_demo.py, add_test_user.py) which talk to asyncpg directly.
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@localhost:5432/agrichain_db

# --- JWT ----------------------------------------------------------------------
# Generate a fresh one per environment:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Anyone holding this value can mint tokens for any account.
SECRET_KEY=CHANGE_ME_GENERATE_A_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Application --------------------------------------------------------------
# DEBUG also gates the ledger tamper-demo endpoints. Must be false in production.
DEBUG=true

# Comma-separated allowed origins, or * to allow any. Narrow this in production:
# "*" together with credentialed requests is rejected by browsers and unsafe.
BACKEND_CORS_ORIGINS=*

# --- Demo / seed data ---------------------------------------------------------
# Password given to the accounts created by seed_demo.py. Local demos only.
DEMO_ACCOUNT_PASSWORD=CHANGE_ME_FOR_DEMOS
